# HeadlessOS Environment Variables

# OpenAI API Key (required for LLM parsing)
OPENAI_API_KEY=sk-your-key-here

# Server port (default: 3001)
PORT=3001

# Only if you run the desktop app and npm run dev on one computer. The app keeps the key to saved
# logins in the OS keychain, which the dev server can't reach, so give it the key here.
# HEADLESSOS_INSTALL_SECRET=

# Log level: debug | info | warn | error
LOG_LEVEL=info
